# Copy to `.env` and fill in to enable Firebase.
# Without these the app runs on an in-browser localStorage store.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Slack incoming webhook for High-Five + check-in nudges.
VITE_SLACK_WEBHOOK_URL=
